digraph PatriciaTree {
    node [style=filled, fillcolor=lightcoral];
    node0 [label="ROOT", shape=box];
    node1 [label="a", shape=box];
    node0 -> node1;
    node2 [label="lgoritmo", shape=doublecircle];
    node1 -> node2;
    node3 [label="rvore", shape=doublecircle];
    node1 -> node3;
    node4 [label="s", shape=doublecircle];
    node3 -> node4;
    node5 [label="b", shape=box];
    node0 -> node5;
    node6 [label="an", shape=box];
    node5 -> node6;
    node7 [label="ana", shape=doublecircle];
    node6 -> node7;
    node8 [label="co", shape=doublecircle];
    node6 -> node8;
    node9 [label="usca", shape=doublecircle];
    node5 -> node9;
}
